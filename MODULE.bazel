module(
    name = "project_reading",
    version = "0.0.0",
    compatibility_level = 1,
)

bazel_dep(name = "rules_dotnet", version = "0.22.2")

# rules_dotnet's compiler_wrapper.sh calls `basename`, which lives in
# coreutils and is absent on NixOS' /usr/bin. Patch it to a pure-bash
# suffix strip so compiler actions do not need PATH at all.
archive_override(
    module_name = "rules_dotnet",
    url = "https://github.com/bazel-contrib/rules_dotnet/releases/download/v0.22.2/rules_dotnet-v0.22.2.tar.gz",
    strip_prefix = "rules_dotnet-0.22.2",
    integrity = "sha256-zjXa0Y2zHNaDI7Vo3AnGicxtdewW66FRDM0Si7XxJk4=",
    patches = [
        "//dotnet:dotnet_private_compiler_wrapper.sh",
        "//dotnet:dotnet_private_common.bzl",
        "//dotnet:dotnet_private_rules_publish_binary_publish_binary.bzl",
        "//dotnet:dotnet_private_rules_fsharp_actions_fsharp_assembly.bzl",
        "//dotnet:dotnet_private_rules_csharp_actions_csharp_assembly.bzl",
        "//dotnet:dotnet_private_rules_nuget_nuget_archive.bzl",
    ],
)
# Mostly Ai Generated - End

bazel_dep(name = "rules_nixpkgs_core", version = "0.14.0")
bazel_dep(name = "platforms", version = "1.0.0")

# Mostly Ai Generated - Start
# Nix-provided .NET SDK: the flake exports `packages.bazel-dotnet-sdk`
# and rules_nixpkgs builds it into the @dotnet_sdk repo, which
# dotnet/nix_sdk_repository.bzl wraps into a rules_dotnet toolchain.
rules_nixpkgs = use_extension("@rules_nixpkgs_core//extensions:rules_nixpkgs.bzl", "rules_nixpkgs")
rules_nixpkgs.flake_package(
    name = "dotnet_sdk",
    nix_flake_file = "//:flake.nix",
    nix_flake_lock_file = "//:flake.lock",
    package = "bazel-dotnet-sdk",
)
use_repo(rules_nixpkgs, "dotnet_sdk")

nix_dotnet_sdk_repository = use_repo_rule("//dotnet:nix_sdk_repository.bzl", "nix_dotnet_sdk_repository")

nix_dotnet_sdk_repository(
    name = "nix_dotnet_toolchain",
    sdk_repo = "dotnet_sdk",
)

register_toolchains(
    "@nix_dotnet_toolchain//:x86_64-unknown-linux-gnu",
    "@nix_dotnet_toolchain//:arm64-unknown-linux-gnu",
    "@nix_dotnet_toolchain//:x86_64-apple-darwin",
    "@nix_dotnet_toolchain//:aarch64-apple-darwin",
)

# Mostly Ai Generated - End

# NuGet packages from paket.lock (generated by rules_dotnet's paket2bazel,
# see README: `bazel run @rules_dotnet//tools/paket2bazel -- --dependencies-file
# $(pwd)/paket.dependencies --output-folder $(pwd)/deps`.
# Mostly Ai Generated - Start
main_extension = use_extension("//deps:paket.main_extension.bzl", "main_extension")
use_repo(main_extension, "paket.main")
# Mostly Ai Generated - End
