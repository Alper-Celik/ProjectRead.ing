<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OpenApiGenerateDocuments>false</OpenApiGenerateDocuments>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>
  <ItemGroup>
    <None Update="./Api.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="ExportGraphQLSchema" AfterTargets="Build">
    <Exec Command="GRAPHQL_EXPORT=1 dotnet run --no-build -- schema export --output &quot;$(MSBuildProjectDirectory)/Schema.graphql&quot;" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>
  <Import Project="..\.paket\Paket.Restore.targets" />
</Project>