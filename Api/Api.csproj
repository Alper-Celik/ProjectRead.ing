<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)</OpenApiDocumentsDirectory>

    <OpenApiGenerateDocuments>true</OpenApiGenerateDocuments>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="EFCore.CheckConstraints" Version="10.0.0" />
    <PackageReference Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageReference Include="FluentValidation" Version="12.1.1" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
    <PackageReference Include="Geralt" Version="4.4.0" />
    <PackageReference Include="GreenDonut" Version="16.7.0-p.5" />
    <PackageReference Include="GreenDonut.Abstractions" Version="16.7.0-p.5" />
    <PackageReference Include="GreenDonut.Data.EntityFramework" Version="16.7.0-p.5" />
    <PackageReference Include="HotChocolate.AspNetCore" Version="16.7.0-p.5" />
    <PackageReference Include="HotChocolate.AspNetCore.Authorization" Version="16.7.0-p.5" />
    <PackageReference Include="HotChocolate.AspNetCore.CommandLine" Version="16.7.0-p.5" />
    <PackageReference Include="HotChocolate.Data" Version="16.7.0-p.5" />
    <PackageReference Include="HotChocolate.Types.Analyzers" Version="16.7.0-p.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="HotChocolate.Types.NodaTime" Version="16.7.0-p.5" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL.NodaTime" Version="10.0.3" />
    <PackageReference Include="Riok.Mapperly" Version="4.3.1" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="NodaTime" Version="3.3.3" />
    <PackageReference Include="NodaTime.Serialization.SystemTextJson" Version="1.4.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Npgsql.NodaTime" Version="10.0.3" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.17.3" />
    <PackageReference Include="SharpGrip.FluentValidation.AutoValidation.Endpoints" Version="2.0.0" />
    <PackageReference Include="Tirion.FairyBread" Version="13.2.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="./Api.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="ExportGraphQLSchema" AfterTargets="Build">
    <Exec Command="GRAPHQL_EXPORT=1 dotnet run --no-build -- schema export --output &quot;$(MSBuildProjectDirectory)/Schema.graphql&quot;" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>
</Project>
